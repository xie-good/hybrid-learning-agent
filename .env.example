# 复制为 .env 后按需填写；密钥仅供后端使用。
# 应用名称和前端连接参数；默认本地运行不需要修改。
APP_NAME=课程学习助手
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=90
# 路径留空时从项目目录定位；SOURCE_PDF 留空时读取预处理报告登记的固定来源。
PROCESSED_DIR=
DATABASE_PATH=
INDEX_DIR=
SOURCE_PDF=
# 运行模式：默认不依赖外部模型。
DEFAULT_RETRIEVAL_MODE=bm25
GENERATION_MODE=extractive
# 大模型服务：选择 GENERATION_MODE=llm 后填写。
# 地址示例：http://127.0.0.1:1234/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 向量模型服务：离线构建索引后方可使用 vector/hybrid；更换模型必须重建。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# 通用参数：模型超时必须大于 0 且不超过 180 秒；跨域地址用英文逗号分隔。
MODEL_TIMEOUT=30
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
